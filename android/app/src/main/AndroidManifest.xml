<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- 체성분(READ_WEIGHT · READ_BODY_FAT · READ_BASAL_METABOLIC_RATE · READ_LEAN_BODY_MASS)과
         수면·운동(READ_SLEEP · READ_EXERCISE · READ_ACTIVE_CALORIES_BURNED · READ_DISTANCE)
         읽기 권한은 프로덕션 액세스 승인 뒤 1.0.10(versionCode 13)에서 한 번에 더한다.
         재신청(9/30 예정) 전에 건강 권한을 늘리면 Play Console 의 Health Connect 선언·
         데이터 보안 양식을 새로 써야 하고, 그 업데이트가 선언 검토에 묶인다.
         코드는 준비돼 있고 선언된 권한만 요청한다. 웹은 versionCode 13 부터 버튼을 보인다. -->

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Habitschool">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name=".HabitschoolLauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Habitschool">

            <!-- 스토어 빌드는 온체인 없는 라이트 경로(/app)만 연다. 정책상 개인 계정으로는
                 암호화폐 지갑을 배포할 수 없어 HBT·지갑·전환·스테이킹을 끈 화면만 노출한다. -->
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://habitschool.web.app/app" />

            <meta-data
                android:name="android.support.customtabs.trusted.METADATA_SHARE_TARGET"
                android:resource="@string/twa_share_target" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <!-- Fitdays 등 체성분 앱의 CSV 내보내기. 앱마다 MIME 이 달라 셋 다 받는다.
                     text/* 로 넓히면 링크·문장 공유에도 해빛스쿨이 떠서 일부러 좁힌다. -->
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="habitschool.web.app"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HealthConnectPermissionActivity"
            android:exported="false"
            android:label="@string/native_health_title"
            android:theme="@style/Theme.Habitschool" />

        <!-- 공유받은 파일을 크롬에 넘길 때 쓰는 통로 (SharedFileRelay). 밖에는 열지 않고,
             TWA 가 공유할 파일에만 읽기 권한을 준다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <activity
            android:name=".HealthConnectBodyActivity"
            android:exported="false"
            android:theme="@style/Theme.Habitschool.TransparentLauncher" />

        <activity
            android:name=".NativeEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.Habitschool.TransparentLauncher">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="habitschool"
                    android:host="health-connect"
                    android:path="/sync" />
                <data
                    android:scheme="habitschool"
                    android:host="health-connect"
                    android:path="/body" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true"
            android:label="@string/native_health_privacy_title"
            android:theme="@style/Theme.Habitschool">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:label="@string/native_health_onboarding_title"
            android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING"
            android:theme="@style/Theme.Habitschool">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_ONBOARDING" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".UAndAboveOnboardingActivity"
            android:exported="true"
            android:permission="android.permission.health.START_ONBOARDING"
            android:targetActivity=".OnboardingActivity">
            <intent-filter>
                <action android:name="android.health.connect.action.SHOW_ONBOARDING" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
            </intent-filter>
        </service>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:exported="false" />

        <receiver
            android:name=".widget.HabitschoolWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habitschool_widget_info" />
        </receiver>

        <service
            android:name=".widget.HabitschoolTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_health"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
