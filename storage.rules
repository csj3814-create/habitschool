rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    
    function isValidSize() {
      return request.resource.size < 20 * 1024 * 1024;
    }
    
    function isValidVideoSize() {
      return request.resource.size < 100 * 1024 * 1024;
    }
    
    // ===== 식단 이미지 =====
    match /diet_images/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 식단 이미지 썸네일 =====
    match /diet_images_thumbnails/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 운동 이미지 =====
    match /exercise_images/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 운동 이미지 썸네일 =====
    match /exercise_images_thumbnails/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 운동 비디오 =====
    match /exercise_videos/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isVideo()
                   && isValidVideoSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 오류 제보 스크린샷 =====
    // 본인 폴더에만 올릴 수 있다. 다른 사람의 제보 스크린샷에는 그 사람의 화면이
    // 그대로 담기므로 읽기도 본인으로 막는다(운영자는 관리자 SDK 로 본다).
    match /bug_reports/{userId}/{allFiles=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 운동 비디오 썸네일 =====
    match /exercise_videos_thumbnails/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 수면 기록 이미지 =====
    match /sleep_images/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 수면 기록 이미지 썸네일 =====
    match /sleep_images_thumbnails/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 걸음수 스크린샷 =====
    match /step_screenshots/{userId}/{allFiles=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ===== 혈액검사 결과지 이미지 =====
    match /blood_tests/{userId}/{allFiles=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 공유 카드 (링크 미리보기용) =====
    // 크롤러가 가져가는 주소는 getDownloadURL이 발급한 토큰 URL이고, 그 토큰은
    // 규칙과 무관하게 열린다. 그러니 경로 자체를 공개할 필요가 없다.
    // 읽기를 본인으로 묶어 두면 남의 uid를 안다고 파일을 훑을 수 없다.
    // 만료된 카드는 cleanupExpiredShareCards가 파일까지 지운다.
    match /share_cards/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImage()
                   && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== 보상몰 쿠폰 이미지 (공급사 원본 미러) =====
    // 공급사는 쿠폰 이미지를 http:// 주소로 내려줄 수 있어 HTTPS 앱에서 mixed content로
    // 막힌다. 발급·복구 시 Functions가 Admin SDK로 여기에 옮겨 두고, 앱에는 토큰이 실린
    // HTTPS 다운로드 URL만 보관함 문서에 남긴다. 그 토큰이 곧 열람 권한이라 경로 자체를
    // 열 필요가 없다. 클라이언트 쓰기는 어떤 경우에도 허용하지 않는다.
    match /reward_coupons/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write, delete: if false;
    }

    // 기본 규칙: 모든 접근 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
